# ──────────────────────────────────────────────
# mongodb.help — production environment
# Copy to /opt/mongodbhelp/deploy/prod/.env on the host (chmod 600).
# ──────────────────────────────────────────────

# ── Image ──
# Tag produced by the Build workflow: :latest or an immutable :<commit-sha>.
IMAGE_TAG=latest
# linux/amd64 while the registry only has amd64 images (qemu on arm64);
# switch to linux/arm64 once the Build workflow has pushed multi-arch images.
APP_PLATFORM=linux/amd64
MONGO_VERSION=8.3.2-noble

# ── Domains ──
AUTH_URL=https://mongodb.help

# ── CORS (comma-separated origins allowed to call the backend) ──
# Keep aligned with the public-facing origins.
CORS_ORIGINS=https://mongodb.help,https://www.mongodb.help,https://leads.mongodb.help

# ── Chat limits (override only if you want different defaults) ──
DAILY_FREE_GRANT=5
ANON_DAILY_CHATS=1
ANON_MESSAGES_PER_CHAT=5
SIGNEDUP_DAILY_CHATS=10
SIGNEDUP_MESSAGES_PER_CHAT=50

# ── MongoDB ──
# Password used to initialize the mongo root user. Generate: openssl rand -base64 32
MONGO_ROOT_PASSWORD=
# Full connection string used by backend/frontend. It must contain the SAME
# password as MONGO_ROOT_PASSWORD above (keep them in sync when rotating).
MONGODB_URI=mongodb://root:CHANGE_ME@mongo:27017/mongodbhelp?authSource=admin

# ── Auth.js (frontend) ──
# 32-byte hex session-signing secret. Generate: openssl rand -hex 32
AUTH_SECRET=

# OAuth providers — create these in each provider's developer console with
# the canonical redirect URI: https://mongodb.help/api/auth/callback/<provider>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Admin dashboard (leads.mongodb.help) — single-password auth ──
# 64-hex password token. Generate: openssl rand -hex 32
ADMIN_PASSWORD=
# HMAC secret used to sign the admin session JWT. Reuse AUTH_SECRET or
# generate a separate one: openssl rand -hex 32
ADMIN_SECRET=

# ── MongoDB Knowledge Service (optional overrides) ──
KS_BASE_URL=https://knowledge.mongodb.com/api/v1
KS_ORIGIN=https://www.mongodb.com
KS_REQUEST_ORIGIN=https://www.mongodb.com/docs/

# HMAC secret shared between the gateway (frontend) and the backend.
# MUST be identical on both. Strong random value: openssl rand -hex 32
GATEWAY_HMAC_SECRET=

# ── Cloudflare Tunnel (only if the cloudflared service in the compose file
# is enabled; the default host setup shares the connector in /opt/checkmate)
# TUNNEL_TOKEN=
